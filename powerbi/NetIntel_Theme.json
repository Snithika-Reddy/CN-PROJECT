{
  "name": "NetIntel 4-Color Pastel Theme",
  "dataColors": [
    "#CDAAEA",
    "#C4BFF0",
    "#CBDFFC",
    "#DFFCF9",
    "#7B32A8",
    "#2563EB",
    "#059669",
    "#D97706"
  ],
  "background": "#DFFCF9",
  "foreground": "#15112B",
  "tableAccent": "#C4BFF0",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 5
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#C4BFF0" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#C4BFF0" } },
            "transparency": 70
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#15112B" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#DFFCF9" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#15112B" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#4C3C6E" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    }
  }
}
