{
  "name": "NetIntel Cyber Intelligence Dark Theme",
  "dataColors": [
    "#71C9CE",
    "#A6E3E9",
    "#10B981",
    "#CBF1F5",
    "#F59E0B",
    "#EF4444",
    "#38BDF8",
    "#A78BFA"
  ],
  "background": "#0B141C",
  "foreground": "#E3FDFD",
  "tableAccent": "#1A2F3D",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#11202D" } },
            "transparency": 10
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#1D3B4E" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "transparency": 50
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#E3FDFD" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0B141C" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#71C9CE" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#A6E3E9" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    }
  }
}
