# NetIntel Environment Configuration Template
# Copy this file to .env and customize for your environment.
# Never commit .env with actual secrets to version control.

# Application Settings
NETINTEL_ENV=development
LOG_LEVEL=INFO

# Power BI Service REST API Integration (Optional Mode B)
# Leave blank if using Local Power BI Desktop Mode A (CSV-based)
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=

# Alerting / Webhooks (Optional)
ALERT_WEBHOOK_URL=
